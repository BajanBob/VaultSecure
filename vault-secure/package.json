{
  "name": "vault-secure",
  "productName": "Vault Secure",
  "version": "1.0.0",
  "private": true,
  "description": "Hide a file inside songs, pictures, memes, videos or documents, locked with a 256-bit QR key and a timer.",
  "main": "electron/main.js",
  "author": {
    "name": "BajanBob",
    "email": "you@example.com"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:kiosk": "electron . --kiosk",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:pi": "electron-builder --linux AppImage deb --arm64 --armv7l",
    "dist:win": "electron-builder --win nsis portable --x64 --arm64",
    "dist:mac": "electron-builder --mac dmg zip --universal",
    "android:add": "cap add android && node scripts/patch-native.js android && cap sync android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "ios:add": "cap add ios --packagemanager SPM && node scripts/patch-native.js ios && cap sync ios",
    "ios:open": "cap open ios",
    "vendor": "node scripts/vendor.js"
  },
  "build": {
    "appId": "com.bajanbob.vaultsecure",
    "productName": "Vault Secure",
    "copyright": "Copyright © 2026 BajanBob",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "www/**",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Vault Secure",
      "artifactName": "Vault-Secure-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Vault-Secure-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null
    }
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "qrcode-generator": "1.4.4",
    "jsqr": "1.4.0",
    "jszip": "3.10.1"
  }
}
